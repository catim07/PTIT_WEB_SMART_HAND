{
  "name": "ptit-web-smart-hand",
  "version": "1.0.0",
  "private": true,
  "description": "SignLink AI Root Runner",
  "scripts": {
    "install-all": "npm install && npm install --prefix frontend",
    "backend": "powershell -ExecutionPolicy Bypass -File ./run-backend.ps1",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
